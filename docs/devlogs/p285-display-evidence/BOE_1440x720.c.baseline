	{ .cmd = 0xBF, .len = 5, .data = {0x00, 0x00, 0x00, 0x04, 0x97} }, /* GEN */
	{ .cmd = 0xC7, .len = 10, .data = {0x00, 0xC2, 0x30, 0x02, 0x42, 0x00, 0x00, 0x00, 0x00, 0x08} }, /* GEN */
	{ .cmd = 0xCE, .len = 1, .data = {0x05} }, /* GEN */
	{ .cmd = 0xE5, .len = 13, .data = {0x06, 0x00, 0x00, 0x00, 0x02, 0x04, 0x00, 0x00, 0x00, 0x04, 0x02, 0x02, 0x00} }, /* GEN */
	{ .cmd = 0xE6, .len = 60, .data = {0x57, 0x5B, 0x5A, 0x85, 0xAA, 0x5C, 0x2F, 0x00, 0x00, 0xAA, 0xAF, 0x85, 0x21, 0xE7, 0x6A, 0x00, 0x3F, 0xF4, 0xFA, 0x5A, 0x83, 0x00, 0xDF, 0x00, 0x9A, 0x00, 0x00, 0x00, 0x00, 0xAA, 0x00, 0x00, 0x00, 0x00, 0xAA, 0x00, 0x00, 0x00, 0x00, 0xAA, 0x14, 0x24, 0x25, 0x00, 0xAA, 0x52, 0x21, 0x59, 0xA1, 0xAA, 0xF7, 0x51, 0x76, 0x4D, 0xA9, 0x00, 0x51, 0xD9, 0x77, 0x9A} }, /* GEN */
	{ .cmd = 0x35, .len = 0, .data = {} }, /* DCS */
	{ .cmd = 0x11, .len = 0, .delay_ms = 75, .data = {} }, /* DCS */
	{ .cmd = 0x29, .len = 0, .data = {} }, /* DCS */
};

static void lcd_panel_init(u32 sel)
{
	u32 i;

	syslog(LOG_INFO, "BOE1440: init HX83102B 0x31d510 body (31 cmds)\n");

	/* 复位后 Himax 要求 ≥120ms 才收命令（原厂这段等待在其 dsim 驱动里做） */
	sunxi_lcd_delay_ms(120);

	for (i = 0; i < 31; i++) {
		const struct hx_cmd *c = &hx_init_seq[i];

		if (c->len == 0)
			sunxi_lcd_dsi_dcs_write_0para(sel, c->cmd);
		else
			sunxi_lcd_dsi_gen_write(sel, c->cmd,
						(u8 *)c->data, c->len);
		if (c->delay_ms)
			sunxi_lcd_delay_ms(c->delay_ms);
	}

	sunxi_lcd_delay_ms(20); /* 0x29 后的显示稳定等待 */
	syslog(LOG_INFO, "BOE1440: init done\n");
}

/* 面板退出序列 (翻译自 DTS panel-exit-sequence)
 *   05 0A 01 28 -> Display Off (0x28, 标准DCS) + 10ms
 *   05 78 01 10 -> Sleep In    (0x10, 标准DCS) + 120ms
 *   39 00 02 04 5A -> GEN 1para 0x04=0x5A (厂商私有命令)
 */
static void lcd_panel_exit(u32 sel)
{
	/* 05 0A 01 28 : Display Off (标准 DCS) */
	sunxi_lcd_dsi_dcs_write_0para(sel, DSI_DCS_SET_DISPLAY_OFF);
	sunxi_lcd_delay_ms(10);

	/* 05 78 01 10 : Sleep In (标准 DCS) + 120ms */
	sunxi_lcd_dsi_dcs_write_0para(sel, DSI_DCS_ENTER_SLEEP_MODE);
	sunxi_lcd_delay_ms(120);

	/* 39 00 02 04 5A : 厂商私有命令，用 gen_write */
	sunxi_lcd_dsi_gen_write_1para(sel, 0x04, 0x5A);
}

/* 用户自定义函数 */
static s32 lcd_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
{
	bsp_disp_lcd_set_bright(sel, 60);
	return 0;
}

struct __lcd_panel BOE_1440x720_panel = {
	/* panel driver name, must match lcd_driver_name in mipi config */
	.name = "BOE_1440x720",
	.func = {
		.cfg_panel_info = lcd_cfg_panel_info,
		.cfg_open_flow = lcd_open_flow,
		.cfg_close_flow = lcd_close_flow,
		.lcd_user_defined_func = lcd_user_defined_func,
	},
};
