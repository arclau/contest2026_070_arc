	{ .cmd = 0xCC, .len = 1, .data = {0x02} }, /* GEN */
	{ .cmd = 0xD3, .len = 39, .data = {0x00, 0x00, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x00, 0x28, 0x00, 0x37, 0x00, 0x33, 0x37, 0x03, 0x03, 0x00, 0x00, 0x32, 0x10, 0x09, 0x00, 0x09, 0x32, 0x10, 0x07, 0x00, 0x07, 0x32, 0x10, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00} }, /* GEN */
