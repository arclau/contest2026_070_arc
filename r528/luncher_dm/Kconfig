config LUNCHER_DM_APP
	bool "DesktopMate YNM-3000 (1920x1200)"
	default n

	---help---
		Enable luncher_dm app (desktop launcher, copy of luncher, base for new app).


if LUNCHER_DM_APP

config LUNCHER_DM_APP_PROGNAME
	string "Program name"
	default "luncher_dm"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config LUNCHER_DM_APP_INPUT_DEVPATH
	string "Touch input device path"
	default "/dev/input0"
	---help---
		Touchscreen input device path used by LVGL NuttX backend.

config LUNCHER_DM_APP_PRIORITY
	int "luncher_dm task priority"
	default 100

config LUNCHER_DM_APP_STACKSIZE
	int "luncher_dm stack size"
	default 102400

config LUNCHER_DM_SIM
	bool "Build for simulator (stub board HAL/xplayer/WiFi/BT)"
	default n
	---help---
		When enabled, luncher_dm links against sim/stubs (empty XPlayer,
		PCM, sunxi HAL, fake WiFi/BT) instead of the R528 board stack.
		Used for goldfish emulator UI development. Board images must
		leave this OFF.

endif

 
