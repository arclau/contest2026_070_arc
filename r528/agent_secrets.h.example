/*
 * agent_secrets.h.example — Build-time secrets TEMPLATE for AI Agent (Vela/NuttX)
 *
 * 复制为 agent_secrets.h 后填入自己的凭证（真实文件永不提交，已被 .gitignore 忽略）：
 *
 *   cp agent_secrets.h.example agent_secrets.h
 *
 *   Backend : Volcengine Ark (火山方舟, OpenAI-compatible)
 *   Endpoint: https://ark.cn-beijing.volces.com/api/v3/chat/completions
 *   语音    : 豆包实时语音（ASR/TTS，火山引擎控制台应用）
 *
 * 本文件被 agent_config.h (`__has_include`) 自动加载，上游源码树零改动；
 * 编译期值仅为开机默认值，运行时 set_llm / set_volc_key 可覆盖
 * （持久化于 /data/agent/config/config.json）。
 */

/* Volcengine Ark API key（火山方舟控制台 → 在线推理 → API Key，ark- 开头） */
#ifndef AGENT_SECRET_API_KEY
#define AGENT_SECRET_API_KEY "YOUR_ARK_API_KEY"
#endif

/* Default chat model（控制台 API 示例确认的准确模型 ID） */
#ifndef AGENT_SECRET_MODEL
#define AGENT_SECRET_MODEL "deepseek-v4-flash-260425"
#endif

/* ── 豆包语音凭证（ASR/TTS，火山引擎控制台应用）──
 * volc_tts.c/volc_asr.c 的 init 在 config_store 为空时回退到这些编译期值，
 * 开机即用无需 set_volc_key/set_volc_asr。运行时 set_* 仍可覆盖（config.json）。 */
#ifndef AGENT_SECRET_VOLC_API_KEY
#define AGENT_SECRET_VOLC_API_KEY "YOUR_VOLC_API_KEY"
#endif
#ifndef AGENT_SECRET_VOLC_APPID
#define AGENT_SECRET_VOLC_APPID "YOUR_VOLC_APPID"
#endif
#ifndef AGENT_SECRET_VOLC_TOKEN
#define AGENT_SECRET_VOLC_TOKEN "YOUR_VOLC_TOKEN"
#endif
#ifndef AGENT_SECRET_VOLC_ASR_CLUSTER
#define AGENT_SECRET_VOLC_ASR_CLUSTER "volcengine_streaming_common"
#endif
