#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config GT911_IIC_TOUCH
	bool "GT911 LCD IIC Touchscreen Driver"
	default n
	depends on INPUT && DRIVERS_TWI
	select INPUT_TOUCHSCREEN
	---help---
		Enable GT911 LCD IIC touchscreen driver support.
		This driver provides touchscreen functionality for the GT911
		LCD module using capacitive touch controller over I2C interface.
		The driver automatically detects the touch controller type.

config GT9271_IIC_TOUCH
	bool "GT9271 LCD IIC Touchscreen Driver"
	default n
	depends on INPUT && DRIVERS_TWI
	select INPUT_TOUCHSCREEN
	---help---
		Enable GT9271 LCD IIC touchscreen driver support.
		Register-compatible with GT911 family, ported with coordinate
		scaling to 1200x1920 BOE panel and I2C failure recovery.

config HX83102_IIC_TOUCH
	bool "HX83102 LCD IIC Touchscreen Driver"
	default n
	depends on INPUT && DRIVERS_TWI && SCHED_LPWORK
	select INPUT_TOUCHSCREEN
	---help---
		Enable HX83102 (Himax) LCD IIC touchscreen driver support.
		Use the BOE module resident firmware and its 56-byte event reports.
		Host firmware download is not supported by this driver.
		Coordinate scaling/rotation targets the 1440x720 BOE panel.

source "drivers/platform/micro_sd/Kconfig"
source "drivers/platform/realtek_ieee80211/Kconfig"
